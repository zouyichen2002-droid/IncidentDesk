{
  "title": "IncidentDesk Operations",
  "uid": "incidentdesk",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "API request rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(incident_http_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "API p95 seconds",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(incident_http_seconds_bucket[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Queued tasks",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "incident_queue_depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active leases",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "incident_active_jobs",
          "refId": "A"
        }
      ]
    }
  ]
}