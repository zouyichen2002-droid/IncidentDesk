    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "logs",
            "deployments",
            "git",
            "runbook",
            "cluster"
          ],
          "title": "Source",
          "type": "string"
        },
        "object": {
          "enum": [
            "Service",
            "Deployment",
            "Commit",
            "Runbook",
            "Incident"
          ],
          "title": "Object",
          "type": "string"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "title": "Path",
          "type": "array"
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "object",
        "path"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "QueryPlan": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStep"
          },
          "maxItems": 12,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "service",
        "start",
        "end",
        "steps"
      ],
      "title": "QueryPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
