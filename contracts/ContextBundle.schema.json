      "const": "1",
      "default": "1",
      "title": "Version",
      "type": "string"
    },
    "scope": {
      "additionalProperties": true,
      "title": "Scope",
      "type": "object"
    },
    "objects": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Objects",
      "type": "array"
    },
    "facts": {
