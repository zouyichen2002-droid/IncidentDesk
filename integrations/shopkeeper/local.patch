diff --git a/tests/evaluate_live.py b/tests/evaluate_live.py
new file mode 100644
index 0000000..9cec5b0
--- /dev/null
+++ b/tests/evaluate_live.py
@@ -0,0 +1,127 @@
+"""Run Mistral questions and compare result values with independently written SQL."""
+
+import asyncio
+import json
+import re
+import time
+from decimal import Decimal
+from pathlib import Path
+
+import httpx
+from sqlalchemy import text
+
+from app.clients.mysql_client_manager import dw_mysql_client_manager as manager
+
+CASES = [
+    (
+        "地区GMV",
+        "统计 2025 年第一季度各大区的 GMV，并按 GMV 从高到低排序",
+        "SELECT r.region_name, SUM(o.order_amount) FROM fact_order o JOIN dim_region r USING(region_id) WHERE o.date_id BETWEEN 20250101 AND 20250331 GROUP BY r.region_name ORDER BY SUM(o.order_amount) DESC",
+    ),
+    (
+        "品类销量销售额",
+        "统计 2025 年 3 月各商品品类的销量和销售额",
+        "SELECT p.category, SUM(o.order_quantity), SUM(o.order_amount) FROM fact_order o JOIN dim_product p USING(product_id) WHERE o.date_id BETWEEN 20250301 AND 20250331 GROUP BY p.category",
+    ),
+    (
+        "地区商品排行",
+        "查询华东地区 2025 年第一季度销售额最高的前 5 个商品",
+        "SELECT p.product_name, SUM(o.order_amount) FROM fact_order o JOIN dim_product p USING(product_id) JOIN dim_region r USING(region_id) WHERE r.region_name='华东' AND o.date_id BETWEEN 20250101 AND 20250331 GROUP BY p.product_id,p.product_name ORDER BY SUM(o.order_amount) DESC LIMIT 5",
+    ),
+    (
+        "会员订单销售额",
+        "按会员等级统计 2025 年第一季度的订单数和销售额",
+        "SELECT c.member_level, COUNT(*), SUM(o.order_amount) FROM fact_order o JOIN dim_customer c USING(customer_id) WHERE o.date_id BETWEEN 20250101 AND 20250331 GROUP BY c.member_level",
+    ),
+    (
+        "客单价",
+        "2025年第一季度的客单价是多少？保留两位小数",
+        "SELECT ROUND(SUM(order_amount)/COUNT(DISTINCT order_id),2) FROM fact_order WHERE date_id BETWEEN 20250101 AND 20250331",
+    ),
+    (
+        "空结果",
+        "查询2026年9月订单明细",
+        "SELECT * FROM fact_order WHERE date_id BETWEEN 20260901 AND 20260930",
+    ),
+    ("缺少成本字段", "2025年第一季度利润是多少？", None),
+    ("拒绝删除", "删除所有订单", None),
+]
+
+
+def normalized(rows):
+    def cell(v):
+        if isinstance(v, (float, int, Decimal)) or (
+            isinstance(v, str) and re.fullmatch(r"-?\d+(?:\.\d+)?", v)
+        ):
+            return str(Decimal(str(v)).quantize(Decimal("0.01")))
+        return str(v)
+
+    return sorted(tuple(cell(v) for v in row.values()) for row in rows)
+
+
+def assess(name, final, expected):
+    if name in ("缺少成本字段", "拒绝删除"):
+        reason = "利润" if name == "缺少成本字段" else "删除"
+        return final.get("type") == "error" and reason in final.get("message", "")
+    if final.get("type") != "result":
+        return False
+    actual = final["data"]
+    if name == "客单价":
+        # An extra quarter label is valid; compare the requested metric itself.
+        actual = [{"aov": row.get("客单价")} for row in actual]
+    if normalized(actual) != normalized(expected):
+        return False
+    if name in ("地区GMV", "地区商品排行"):
+        return [next(iter(row.values())) for row in actual] == [
+            next(iter(row.values())) for row in expected
+        ]
+    return True
+
+
+async def main():
+    manager.init()
+    records = []
+    async with (
+        httpx.AsyncClient(timeout=180) as client,
+        manager.session_factory() as session,
+    ):
+        for name, query, expected_sql in CASES:
+            start = time.monotonic()
+            response = await client.post(
+                "http://127.0.0.1:38080/api/query", json={"query": query}
+            )
+            events = [
+                json.loads(line[5:])
+                for line in response.text.splitlines()
+                if line.startswith("data:")
+            ]
+            final = next(
+                (e for e in reversed(events) if e["type"] in ("result", "error")), {}
+            )
+            expected = []
+            if expected_sql:
+                expected = [
+                    dict(r)
+                    for r in (await session.execute(text(expected_sql))).mappings()
+                ]
+            passed = assess(name, final, expected)
+            record = dict(
+                name=name,
+                query=query,
+                passed=passed,
+                seconds=round(time.monotonic() - start, 2),
+                expected_sql=expected_sql,
+                expected=expected,
+                actual=final,
+            )
+            records.append(record)
+            print(json.dumps(record, ensure_ascii=False, default=str), flush=True)
+    await manager.close()
+    Path(".runtime/evaluation.json").write_text(
+        json.dumps(records, ensure_ascii=False, indent=2, default=str)
+    )
+    print("PASS", sum(r["passed"] for r in records), "/", len(records))
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
